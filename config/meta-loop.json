{
	"enabled": true,
	"roles": {
		"orchestrator": {
			"model": "",
			"tools": ["read", "bash", "ls", "find", "grep"]
		},
		"supervisor": {
			"model": "",
			"tools": ["read", "bash", "ls", "find", "grep"]
		},
		"worker": {
			"model": "",
			"tools": ["read", "write", "edit", "bash", "ls", "find", "grep"]
		}
	},
	"supervisor": {
		"auto": true,
		"checkIntervalMinutes": 30,
		"workerStartThreshold": 6,
		"maxConsecutiveFailures": 2
	},
	"executor": {
		"sfhEnabled": true,
		"sfhBinary": "sfh",
		"timeoutSec": 1800,
		"maxParallel": 4
	},
	"limits": {
		"maxTasks": 8,
		"concurrency": 1,
		"perTaskOutputCap": 51200
	},
	"notes": "model が空なら pi のデフォルトモデルを継承。supervisor.* = 自動監査フック。executor.* = sfh 委譲（execution:sfh チケット）。sfh は必須依存。"
}
