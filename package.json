{
	"name": "pi-meta-loop",
	"version": "0.1.0",
	"description": "Adaptive supervised orchestration for pi: short tasks stay lightweight, long tasks get an Orchestrator + Supervisor + Workers with role-split models, automatic supervision hooks, and standards-based review.",
	"license": "MIT",
	"type": "module",
	"keywords": ["pi-package", "orchestration", "multi-agent", "metacognition", "supervision"],
	"pi": {
		"extensions": ["./src/index.ts"],
		"skills": ["./skills"]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.83.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@types/node": "^26.1.2",
		"typebox": "^1.3.10",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=20"
	}
}
