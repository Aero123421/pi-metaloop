{
	"_comment": "プロジェクト個別設定の例。この内容を <プロジェクト>/.pi/meta-loop.json として置くと拡張デフォルトを上書きできる。",
	"roles": {
		"orchestrator": { "model": "" },
		"supervisor": { "model": "" },
		"worker": { "model": "" }
	},
	"supervisor": {
		"auto": true,
		"checkIntervalMinutes": 30,
		"workerStartThreshold": 6,
		"maxConsecutiveFailures": 2
	},
	"limits": {
		"maxTasks": 8,
		"concurrency": 1
	}
}
