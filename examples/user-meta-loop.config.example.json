{
	"config_version": 1,
	"_comment": "ユーザー全体設定の例。~/.pi/agent/meta-loop/config.json に置く。verifyProfile を選ばないと native チケットは done にならない。",
	"allowProjectModelOverride": false,
	"roles": {
		"orchestrator": {
			"model": "qwen-token-plan/qwen3.8-max-preview"
		},
		"supervisor": {
			"model": "qwen-token-plan/qwen3.8-max-preview"
		},
		"worker": {
			"model": "qwen-token-plan/qwen3.8-max-preview"
		}
	},
	"executor": {
		"sfhEnabled": true,
		"sfhBinary": "sfh",
		"timeoutSec": 1800,
		"maxParallel": 4,
		"sfhModel": "",
		"sfhIntegrateModel": "",
		"sfhIntegrateTool": "",
		"sfhToolModels": {
			"pi": "qwen-token-plan/qwen3.8-max-preview",
			"opencode": "",
			"codex": "",
			"claude": ""
		},
		"verifyProfiles": {
			"node": [
				[
					"npm",
					"test"
				],
				[
					"npm",
					"run",
					"typecheck"
				]
			],
			"rust": [
				[
					"cargo",
					"test",
					"--locked"
				]
			]
		},
		"verifyProfile": "node",
		"verifyMode": "per-ticket",
		"verifyTimeoutSec": 600
	},
	"supervisor": {
		"auto": true,
		"checkIntervalMinutes": 30,
		"workerStartThreshold": 6,
		"maxConsecutiveFailures": 2
	},
	"limits": {
		"maxTasks": 8,
		"maxSupervisions": 12,
		"scopeCeiling": [
			"src/**",
			"test/**"
		]
	}
}
