{
	"enabled": true,
	"roles": {
		"orchestrator": {
			"model": "",
			"tools": ["read", "bash", "ls", "find", "grep"]
		},
		"supervisor": {
			"model": "",
			"tools": ["read", "bash", "ls", "find", "grep"]
		},
		"worker": {
			"model": "",
			"tools": ["read", "write", "edit", "bash", "ls", "find", "grep"]
		}
	},
	"supervisor": {
		"auto": true,
		"checkIntervalMinutes": 30,
		"workerStartThreshold": 6,
		"maxConsecutiveFailures": 2
	},
	"executor": {
		"sfhEnabled": true,
		"sfhBinary": "sfh",
		"timeoutSec": 1800,
		"maxParallel": 4,
		"sfhModel": "",
		"sfhIntegrateModel": "",
		"sfhToolModels": {}
	},
	"limits": {
		"maxTasks": 8,
		"concurrency": 1,
		"perTaskOutputCap": 51200
	},
	"notes": "model が空なら pi のデフォルトモデルを継承。roles.*.model = Primary 側の役別モデル。executor.sfhModel / sfhToolModels / sfhIntegrateModel = sfh 側のモデル。設定の読み込み順: 拡張デフォルト → ~/.pi/agent/meta-loop/config.json → .pi/meta-loop/config.json"
}
