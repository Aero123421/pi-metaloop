{
	"name": "pi-meta-loop",
	"version": "0.2.0-alpha",
	"description": "Experimental adaptive supervised orchestration for pi (alpha). Short tasks stay light; long tasks get Orchestrator + Supervisor + Workers/sfh with fail-closed audit and evidence-based completion.",
	"license": "MIT",
	"type": "module",
	"keywords": ["pi-package", "orchestration", "multi-agent", "metacognition", "supervision"],
	"pi": {
		"extensions": ["./src/index.ts"],
		"skills": ["./skills"]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.83.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@types/node": "^26.1.2",
		"typebox": "^1.3.10",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test test/**/*.test.ts"
	},
	"engines": {
		"node": ">=20"
	}
}
